<odoo>
    <data noupdate="1">
        <record id="ir_cron_asset_pm_scheduler" model="ir.cron">
            <field name="name">Asset PM Scheduler</field>
            <field name="model_id" ref="asset_management.model_asset_maintenance_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_contract_pm()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="seq_asset_inspection" model="ir.sequence">
            <field name="name">Asset Inspection</field>
            <field name="code">asset.inspection</field>
            <field name="prefix">INSP/%(year)s/</field>
            <field name="padding">4</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="seq_asset_job_order" model="ir.sequence">
            <field name="name">Asset Job Order</field>
            <field name="code">asset.job.order</field>
            <field name="prefix">JO-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="cron_auto_close_unsigned_job_orders" model="ir.cron">
            <field name="name">Job Orders: Auto-close unsigned after 5 days</field>
            <field name="model_id" ref="model_asset_job_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_close_unsigned_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
    <record id="cron_send_task_reminders" model="ir.cron">
        <field name="name">Asset Tasks: Send Responsible Reminders</field>
        <field name="model_id" ref="model_asset_maintenance_task"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_task_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
