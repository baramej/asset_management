<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_material_rejection_wizard_form" model="ir.ui.view">
        <field name="name">asset.material.rejection.wizard.form</field>
        <field name="model">asset.material.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Material Request">
                <group>
                    <field name="material_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Explain why this material is being rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>