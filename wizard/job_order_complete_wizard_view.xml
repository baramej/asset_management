<odoo>
    <record id="view_asset_job_material_request_wizard" model="ir.ui.view">
        <field name="name">asset.job.material.request.wizard.form</field>
        <field name="model">asset.job.material.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Materials">
                <field name="job_order_id" invisible="1"/>
                <group string="Materials to Request">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="material_line_id" invisible="1"/>
                            <field name="product_id"
                                   options="{'no_create': True}"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="qty_available"
                                   readonly="1"
                                   decoration-danger="qty_available == 0"
                                   decoration-warning="qty_available &lt; quantity_requested"
                                   decoration-success="qty_available &gt;= quantity_requested"/>
                            <field name="quantity_requested"/>
                            <field name="is_consumable"
                                   string="Consumable"
                                   widget="boolean_toggle"
                                   readonly="1"
                                   decoration-success="is_consumable == True"
                                   decoration-warning="is_consumable == False"/>
                            <field name="description"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Request Materials"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_asset_job_complete_wizard" model="ir.ui.view">
        <field name="name">asset.job.complete.wizard.form</field>
        <field name="model">asset.job.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="End Work — Confirm Materials">
                <field name="job_order_id" invisible="1"/>
                <field name="has_non_consumables" invisible="1"/>

                <group string="Material Consumption" invisible="not line_ids">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="material_line_id" invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="is_consumable"
                                   readonly="1"
                                   widget="boolean_toggle"
                                   string="Consumable"
                                   decoration-success="is_consumable == True"
                                   decoration-warning="is_consumable == False"/>
                            <field name="quantity_requested"
                                   readonly="1"
                                   string="Planned"/>
                            <field name="quantity_used"
                                   string="Used"
                                   readonly="not is_consumable"
                                   invisible="not is_consumable"/>
                            <field name="consumption_state"
                                   string="Status"
                                   widget="badge"
                                   readonly="not is_consumable"
                                   decoration-success="consumption_state == 'consumed'"
                                   decoration-warning="consumption_state == 'returned'"
                                   decoration-secondary="consumption_state == 'pending_return'"/>
                        </list>
                    </field>

                    <div class="alert alert-info" role="alert"
                         invisible="not has_non_consumables">
                        <i class="fa fa-info-circle"/>
                        Non-consumable equipment (shown with <b>Pending Return</b> status)
                        will be automatically flagged for return to the store after work ends.
                        The Storekeeper will be notified.
                    </div>
                </group>

                <group invisible="line_ids">
                    <div class="alert alert-info" role="alert">
                        No collected materials to confirm for this job.
                    </div>
                </group>

                <group string="Technician Notes">
                    <field name="technician_notes" nolabel="1"
                           placeholder="Describe work performed..."/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="End Work"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_asset_job_close_wizard" model="ir.ui.view">
        <field name="name">asset.job.close.wizard.form</field>
        <field name="model">asset.job.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Job Order">
                <field name="job_order_id" invisible="1"/>
                <group string="Sign Off">
                    <field name="signed_by_name"
                           placeholder="Enter your full name to sign off..."/>
                    <field name="signature" widget="signature"/>
                </group>
                <group string="Closing Notes">
                    <field name="supervisor_close_notes" nolabel="1"
                           placeholder="Any final notes before closing..."/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Close Job Order"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_asset_job_approve_wizard" model="ir.ui.view">
        <field name="name">asset.job.approve.wizard.form</field>
        <field name="model">asset.job.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Job Order">
                <sheet>
                    <!-- Show a note when customer_approval is off -->
                    <div class="alert alert-info"
                         invisible="job_order_id.customer_approval != False"
                         role="alert">
                        <strong>Note:</strong>
                        Customer approval is not required for this job order.
                        This signature will both approve <em>and</em> close the job order in one step.
                    </div>
                    <group>
                        <field name="customer_approval" invisible="1"/>
                        <field name="job_order_id" invisible="1"/>
                        <field name="signed_by_name" placeholder="Enter full name..."/>
                        <field name="signature" widget="signature" required="1"/>
                        <field name="approval_notes" placeholder="Optional notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object"
                            name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>