<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_inspection_complete_wizard_form" model="ir.ui.view">
        <field name="name">asset.inspection.complete.wizard.form</field>
        <field name="model">asset.inspection.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete Inspection">
                <field name="inspection_id" invisible="1"/>
                <field name="has_non_consumables" invisible="1"/>

                <group string="Material Consumption" invisible="not line_ids">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="material_id" invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="is_consumable"
                                   readonly="1"
                                   widget="boolean_toggle"
                                   string="Consumable"/>
                            <field name="qty_requested" readonly="1" string="Requested"/>
                            <field name="qty_consumed"
                                   string="Consumed"
                                   readonly="not is_consumable"
                                   invisible="not is_consumable"/>
                            <field name="consumption_state"
                                   string="Status"
                                   widget="badge"
                                   readonly="not is_consumable"
                                   decoration-success="consumption_state == 'consumed'"
                                   decoration-warning="consumption_state == 'returned'"
                                   decoration-secondary="consumption_state == 'pending_return'"/>
                        </list>
                    </field>

                    <!-- Info banner: shown only when non-consumables exist -->
                    <div class="alert alert-info" role="alert"
                         invisible="not has_non_consumables">
                        <i class="fa fa-info-circle"/>
                        Items marked as <b>Pending Return</b> — including non-consumable equipment
                        and partially consumed materials — will be flagged for return to the store
                        after completion. The Storekeeper will be notified by email.
                    </div>
                </group>

                <group invisible="line_ids">
                    <div class="alert alert-info" role="alert">
                        No collected materials to confirm for this inspection.
                    </div>
                </group>

                <separator/>

                <group string="Escalation Decision">
                    <field name="escalation_required"
                           widget="radio"
                           required="1"/>
                    <field name="resolution_notes"
                           placeholder="Describe how the issue was resolved..."
                           invisible="escalation_required != 'no'"/>
                    <field name="escalation_notes"
                           placeholder="Describe what corrective maintenance is needed..."
                           invisible="escalation_required != 'yes'"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Complete Inspection"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>