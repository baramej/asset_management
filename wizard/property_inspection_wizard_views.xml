<odoo>
    <record id="view_property_inspection_wizard_form" model="ir.ui.view">
        <field name="name">property.inspection.wizard.form</field>
        <field name="model">property.inspection.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Inspection">
                <sheet>
                    <group>
                        <group string="Location">
                            <field name="property_id" readonly="1"/>
                            <field name="building_id" readonly="1"/>
                            <field name="flat_no" readonly="1"/>
                            <field name="occupant_id" readonly="1"/>
                        </group>
                        <group string="Inspection">
                            <field name="inspection_type" widget="radio"/>
                            <field name="scheduled_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Any notes for this inspection..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            string="Create Ticket"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>