<odoo>

    <record id="view_flat_checklist_template_form" model="ir.ui.view">
        <field name="name">asset.flat.checklist.template.form</field>
        <field name="model">asset.flat.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Flat Checklist Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template name…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="line_count" string="Total Items" readonly="1"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="description" placeholder="Optional description…"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Keys" name="keys">
                            <field name="line_keys_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description" string="Item" required="1"/>
                                    <field name="expected_qty" string="Expected Qty"/>
                                    <field name="is_meter_reading" string="Meter Reading"/>
                                    <field name="section" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Electrical" name="electrical">
                            <field name="line_electrical_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description" string="Item" required="1"/>
                                    <field name="expected_qty" string="Expected Qty"/>
                                    <field name="is_meter_reading" string="Meter Reading"/>
                                    <field name="section" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Plumbing" name="plumbing">
                            <field name="line_plumbing_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description" string="Item" required="1"/>
                                    <field name="expected_qty" string="Expected Qty"/>
                                    <field name="is_meter_reading" string="Meter Reading"/>
                                    <field name="section" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="General / Damages" name="general">
                            <field name="line_general_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description" string="Item" required="1"/>
                                    <field name="expected_qty" string="Expected Qty"/>
                                    <field name="is_meter_reading" string="Meter Reading"/>
                                    <field name="section" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other" name="other">
                            <field name="line_other_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description" string="Item" required="1"/>
                                    <field name="expected_qty" string="Expected Qty"/>
                                    <field name="is_meter_reading" string="Meter Reading"/>
                                    <field name="section" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flat_checklist_template_list" model="ir.ui.view">
        <field name="name">asset.flat.checklist.template.list</field>
        <field name="model">asset.flat.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <field name="name"/>
                <field name="location"/>
                <field name="line_count" string="Items"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_flat_checklist_template" model="ir.actions.act_window">
        <field name="name">Flat Checklist Templates</field>
        <field name="res_model">asset.flat.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_flat_checklist_templates"
            name="Flat Checklist Templates"
            parent="menu_asset_mgmt_config"
            action="action_flat_checklist_template"
            sequence="50"/>

</odoo>