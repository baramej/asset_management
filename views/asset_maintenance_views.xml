<odoo>
    <record id="view_asset_maintenance_task_list" model="ir.ui.view">
        <field name="name">asset.maintenance.task.list</field>
        <field name="model">asset.maintenance.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="maintenance_type"/>
                <field name="scheduled_date"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'cancel'"/>
                <field name="due_badge" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="is_upcoming and state != 'done'"
                       decoration-danger="is_overdue and state != 'done'"
                       decoration-info="not is_upcoming and not is_overdue and state != 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_maintenance_task_form" model="ir.ui.view">
        <field name="name">asset.maintenance.task.form</field>
        <field name="model">asset.maintenance.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_job_order"
                            string="Create Job Order"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or job_order_id != False"/>
                    <button name="action_view_job_order"
                            string="Open Job Order"
                            type="object"
                            class="btn-secondary"
                            invisible="job_order_id == False or state == 'done'"/>
                    <button name="action_set_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ['assigned', 'cancel']"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state in ['done', 'cancel']"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,assigned,in_progress,done"/>
                </header>

                <sheet>
                    <!-- ── Smart Buttons ── -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspection"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-search"
                                invisible="inspection_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="inspection_count"/>
                                </span>
                                <span class="o_stat_text">Inspection</span>
                            </div>
                        </button>
                        <button name="action_view_job_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="job_order_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="job_order_count"/>
                                </span>
                                <span class="o_stat_text">Job Order</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_open_delivery_orders"
                                class="oe_stat_button"
                                icon="fa-truck">
                            <field name="picking_ids" widget="statinfo" string="Deliveries"/>
                        </button>
                    </div>

                    <!-- ── Title ── -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Task name..."/>
                        </h1>
                    </div>

                    <!-- ── Section 1: Core Details ── -->
                    <group string="Task Details">
                        <group>
                            <field name="asset_id"/>
                            <field name="maintenance_type"/>
                            <field name="service_type"
                                   invisible="maintenance_type == 'corrective'"/>
                            <field name="is_emergency"
                                   widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="request_date" readonly="1"/>
                            <field name="done_date" readonly="1"/>
                            <field name="due_badge" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-warning="is_upcoming and state != 'done'"
                                   decoration-danger="is_overdue and state != 'done'"
                                   decoration-info="not is_upcoming and not is_overdue and state != 'done'"/>
                        </group>
                    </group>

                    <!-- ── Section 2: Assignment & Billing ── -->
                    <group string="Assignment &amp; Billing">
                        <group>
                            <field name="maintenance_team_id"/>
                            <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            <div colspan="2" invisible="not maintenance_team_id">
                                <button name="action_view_team_schedule"
                                        string="View Team Schedule"
                                        type="object"
                                        class="btn-secondary btn-sm"
                                        icon="fa-calendar"/>
                            </div>
                        </group>
                        <group>
                            <field name="billing_entity_id"
                                   options="{'no_create': True}"
                                   placeholder="Auto-filled from asset..."/>
                            <field name="contract_id" readonly="1"
                                   invisible="not contract_id"/>
                        </group>
                    </group>

                    <!-- ── Section 3: Linked Records ── -->
                    <group string="Linked Records"
                           invisible="helpdesk_ticket_id == False and inspection_id == False">
                        <group>
                            <field name="helpdesk_ticket_id"
                                   readonly="1"
                                   invisible="helpdesk_ticket_id == False"/>
                            <field name="inspection_id"
                                   readonly="1"
                                   invisible="inspection_id == False"/>
                        </group>
                    </group>

                    <!-- ── Section 4: Supervisor Sign-off ── -->
                    <group string="Supervisor Sign-off"
                           invisible="not requires_supervisor_signoff">
                        <group>
                            <field name="requires_supervisor_signoff" widget="boolean_toggle"/>
                            <field name="supervisor_signoff_state" widget="badge"
                                   decoration-success="supervisor_signoff_state == 'approved'"
                                   decoration-warning="supervisor_signoff_state == 'pending'"
                                   decoration-danger="supervisor_signoff_state == 'rejected'"
                                   decoration-muted="supervisor_signoff_state == 'not_required'"/>
                        </group>
                        <group>
                            <field name="supervisor_signoff_by" readonly="1"
                                   invisible="not supervisor_signoff_by"/>
                            <field name="supervisor_signoff_date" readonly="1"
                                   invisible="not supervisor_signoff_date"/>
                        </group>
                        <group colspan="2">
                            <field name="supervisor_signoff_note"
                                   placeholder="Sign-off notes..."
                                   invisible="not requires_supervisor_signoff"/>
                        </group>
                        <div colspan="2" invisible="supervisor_signoff_state not in ('not_required', 'rejected')">
                            <button name="action_request_supervisor_signoff"
                                    string="Request Sign-off"
                                    type="object"
                                    class="btn-secondary btn-sm"
                                    icon="fa-paper-plane"/>
                        </div>
                        <div colspan="2" invisible="supervisor_signoff_state != 'pending'"
                             groups="asset_management.group_asset_supervisor">
                            <button name="action_supervisor_approve_signoff"
                                    string="Approve Sign-off"
                                    type="object"
                                    class="btn-success btn-sm"
                                    icon="fa-check"/>
                            <button name="action_supervisor_reject_signoff"
                                    string="Reject Sign-off"
                                    type="object"
                                    class="btn-danger btn-sm"
                                    icon="fa-times"/>
                        </div>
                    </group>

                    <!-- ── Notebook ── -->
                    <notebook>

                        <page string="Checklist" name="checklist" invisible="maintenance_type == 'corrective'">
                            <group>
                                <field name="checklist_progress"
                                       widget="progressbar"
                                       options="{'editable': false}"/>
                            </group>
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="is_mandatory" widget="boolean_toggle"/>
                                    <field name="is_done" widget="boolean_toggle"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Findings" name="task_findings">
                            <field name="task_finding_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_from_inspection"
                                           readonly="1"
                                           widget="boolean_toggle"
                                           optional="show"/>
                                    <field name="description" required="1"/>
                                    <field name="severity"
                                           widget="badge"
                                           decoration-danger="severity == 'critical'"
                                           decoration-warning="severity == 'high'"
                                           decoration-info="severity == 'medium'"
                                           decoration-secondary="severity == 'low'"/>
                                    <field name="notes" optional="show"/>
                                    <field name="image_1"
                                           widget="image"
                                           options="{'size': [38, 38]}"
                                           string="Photo"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="description"/>
                                            <field name="severity"/>
                                            <field name="is_from_inspection" readonly="1"/>
                                            <field name="notes"/>
                                        </group>
                                        <group>
                                            <field name="image_1" widget="image"
                                                   options="{'size': [300,300]}"
                                                   string="Photo 1"/>
                                            <field name="image_2" widget="image"
                                                   options="{'size': [300,300]}"
                                                   string="Photo 2"/>
                                            <field name="image_3" widget="image"
                                                   options="{'size': [300,300]}"
                                                   string="Photo 3"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Materials Required" name="task_materials"
                        >
                            <field name="planned_material_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description" optional="show"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="on_hand_qty"
                                           readonly="1"
                                           string="Available"
                                           decoration-danger="on_hand_qty == 0"
                                           decoration-warning="on_hand_qty &lt; quantity"
                                           decoration-success="on_hand_qty &gt;= quantity"/>
                                    <field name="quantity" string="Qty Required"/>
                                </list>
                            </field>
                        </page>

                        <!--                        <page string="Labour Plan" name="task_labour">-->
                        <!--                            <group>-->
                        <!--                                <group>-->
                        <!--                                    <field name="planned_hours"/>-->
                        <!--                                    <field name="actual_hours" readonly="1"/>-->
                        <!--                                </group>-->
                        <!--                            </group>-->
                        <!--                            <field name="planned_labour_ids">-->
                        <!--                                <list editable="bottom">-->
                        <!--                                    <field name="user_id" widget="many2one_avatar_user"/>-->
                        <!--                                    <field name="role"/>-->
                        <!--                                    <field name="planned_hours"/>-->
                        <!--                                    <field name="notes"/>-->
                        <!--                                </list>-->
                        <!--                            </field>-->
                        <!--                        </page>-->

                        <page string="Consumed Parts" name="consumed_parts"
                              invisible="maintenance_type == 'corrective'">
                            <field name="consumed_part_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="usage_type"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes" name="description_notes">
                            <group string="Task Description">
                                <field name="description" nolabel="1"
                                       placeholder="Describe the maintenance work required..."/>
                            </group>
                            <group string="Supervisor Notes"
                                   groups="asset_management.group_asset_supervisor">
                                <field name="supervisor_notes" nolabel="1"
                                       placeholder="Internal supervisor notes..."/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── AMC Contract List ── -->
    <record id="view_asset_maintenance_contract_list" model="ir.ui.view">
        <field name="name">asset.maintenance.contract.list</field>
        <field name="model">asset.maintenance.contract</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="customer_id"/>
                <field name="vendor_id" optional="show"/>
                <field name="contract_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_to_expiry" string="Days Left" optional="show"/>
                <field name="asset_count" string="Assets"/>
                <field name="visits_completed" string="Visits Done"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ── AMC Contract Form ── -->
    <record id="view_asset_maintenance_contract_form" model="ir.ui.view">
        <field name="name">asset.maintenance.contract.form</field>
        <field name="model">asset.maintenance.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'cancelled')"/>
                    <button name="action_log_service_visit"
                            string="Log Service Visit"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('active', 'expiring')"/>
                    <button name="action_cancel"
                            string="Cancel Contract"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('expired', 'cancelled')"
                            confirm="Are you sure you want to cancel this contract?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expiring,expired"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="visits_completed"/>/
                                    <field name="visit_count"/>
                                </span>
                                <span class="o_stat_text">Visits</span>
                            </div>
                        </button>
                        <button name="action_view_assets"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cube"
                                invisible="asset_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="asset_count"/>
                                </span>
                                <span class="o_stat_text">Assets</span>
                            </div>
                        </button>
                    </div>

                    <!-- Expiry warning banner -->
                    <div class="alert alert-warning mb-3"
                         invisible="state != 'expiring'">
                        <i class="fa fa-exclamation-triangle"/>
                        This contract expires
                        in
                        <strong>
                            <field name="days_to_expiry" readonly="1"/>
                        </strong>
                        days
                        on<field name="end_date" readonly="1"/>. Please arrange renewal.
                    </div>
                    <div class="alert alert-danger mb-3"
                         invisible="state != 'expired'">
                        <i class="fa fa-times-circle"/>
                        This contract has
                        <strong>expired</strong>. Assets may no longer be covered.
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Contract name..."/>
                        </h1>
                        <field name="reference"
                               placeholder="Contract reference / number"
                               style="font-size:14px;color:var(--color-text-secondary)"/>
                    </div>

                    <!-- Section 1: Parties & Dates -->
                    <group string="Contract Details">
                        <group string="Parties">
                            <field name="customer_id"
                                   options="{'no_create': True}"
                                   string="Client"/>
                            <field name="vendor_id"
                                   options="{'no_create': True}"
                                   string="Service Provider"/>
                        </group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days_to_expiry" readonly="1"
                                   string="Days Remaining"
                                   invisible="state in ('draft','cancelled')"/>
                            <field name="renewal_reminder_days"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <!-- Section 2: Coverage -->
                    <group string="Coverage &amp; Scope">
                        <group string="Contract Type">
                            <field name="contract_type" widget="radio"/>
                        </group>
                        <group string="Coverage Summary (auto)">
                            <field name="labour_covered"
                                   widget="boolean_toggle"
                                   readonly="1"
                                   string="Labour / Visits Covered"/>
                            <field name="parts_covered"
                                   readonly="1"
                                   string="Parts Coverage"
                                   widget="badge"
                                   decoration-success="parts_covered == 'all'"
                                   decoration-warning="parts_covered == 'consumables'"
                                   decoration-danger="parts_covered == 'none'"/>
                        </group>
                        <group string="Inclusions" colspan="2">
                            <field name="inclusions" nolabel="1"
                                   placeholder="e.g. 4 scheduled PM visits per year, labour, travel, emergency call-out within 24h..."/>
                        </group>
                        <group string="Exclusions" colspan="2">
                            <field name="exclusions" nolabel="1"
                                   placeholder="e.g. Spare parts, consumables, damage due to misuse, acts of nature..."/>
                        </group>
                    </group>

                    <!-- Section 3: Schedule & Financial -->
                    <group string="Schedule &amp; Commercial">
                        <group string="Service Schedule">
                            <field name="visits_per_year"/>
                            <field name="pm_frequency_days"/>
                            <field name="next_service_date"/>
                        </group>
                        <group string="Financial">
                            <field name="contract_value"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="payment_terms"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Assets tab -->
                        <page string="Assets Under Contract" name="assets">
                            <field name="contract_line_ids">
                                <list editable="bottom">
                                    <field name="asset_id"/>
                                    <field name="asset_location" readonly="1" optional="show"/>
                                    <field name="last_pm_date" readonly="1" optional="show"/>
                                    <field name="next_pm_date"/>
                                    <field name="remaining_visits"/>
                                    <field name="due_status" readonly="1"
                                           decoration-danger="'overdue' in due_status"
                                           decoration-warning="'⚠' in due_status"/>
                                    <field name="special_terms" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- Service Visit Log tab -->
                        <page string="Service Visit Log" name="visits">
                            <field name="service_visit_ids">
                                <list decoration-success="status == 'completed'"
                                      decoration-warning="status == 'in_progress'"
                                      decoration-muted="status == 'cancelled'">
                                    <field name="visit_date"/>
                                    <field name="asset_id"/>
                                    <field name="visit_type" widget="badge"/>
                                    <field name="technician_name"/>
                                    <field name="technician_company" optional="show"/>
                                    <field name="is_covered_under_contract"
                                           widget="boolean_toggle"
                                           string="Covered"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'completed'"
                                           decoration-warning="status == 'in_progress'"
                                           decoration-muted="status == 'cancelled'"/>
                                    <field name="report_ref" optional="show"/>
                                    <button name="action_mark_completed"
                                            string="Mark Completed"
                                            type="object"
                                            icon="fa-check"
                                            class="btn-success btn-sm"
                                            invisible="status == 'completed'"/>
                                </list>
                                <form string="Service Visit">
                                    <header>
                                        <button name="action_mark_completed"
                                                string="Mark as Completed"
                                                type="object"
                                                class="btn-success"
                                                invisible="status == 'completed'"/>
                                        <button name="action_view_attachments"
                                                string="Attachments"
                                                type="object"
                                                class="btn-secondary"/>
                                        <field name="status" widget="statusbar"
                                               statusbar_visible="scheduled,in_progress,completed"/>
                                    </header>
                                    <sheet>
                                        <field name="contract_asset_ids" invisible="1"/>
                                        <group>
                                            <group string="Visit Details">
                                                <field name="visit_date"/>
                                                <field name="asset_id"/>
                                                <field name="visit_type"/>
                                                <field name="is_covered_under_contract"
                                                       widget="boolean_toggle"/>
                                                <field name="billing_note"
                                                       invisible="is_covered_under_contract"/>
                                                <field name="report_ref"/>
                                            </group>
                                            <group string="Technician">
                                                <field name="technician_name"/>
                                                <field name="technician_company"/>
                                                <field name="next_visit_date"/>
                                            </group>
                                        </group>
                                        <group string="Work Carried Out">
                                            <field name="work_done" nolabel="1"
                                                   placeholder="Describe the work performed..."/>
                                        </group>
                                        <group string="Findings &amp; Observations">
                                            <field name="findings" nolabel="1"
                                                   placeholder="Any issues found, recommendations, follow-up needed..."/>
                                        </group>
                                        <group string="Parts / Materials Used">
                                            <field name="parts_used" nolabel="1"
                                                   placeholder="List spare parts or consumables used..."/>
                                        </group>
                                    </sheet>
                                    <chatter/>
                                </form>
                            </field>
                        </page>

                        <!-- Terms tab -->
                        <page string="Terms &amp; Notes" name="terms">
                            <group string="Terms &amp; Conditions Summary">
                                <field name="terms_and_conditions" nolabel="1"
                                       placeholder="Paste or summarise the key T&amp;Cs from the signed contract..."/>
                            </group>
                            <group string="Internal Notes">
                                <field name="notes" nolabel="1"
                                       placeholder="Internal notes, renewal history, contact persons..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_contract_visit_list" model="ir.ui.view">
        <field name="name">asset.contract.service.visit.list</field>
        <field name="model">asset.contract.service.visit</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'completed'"
                  decoration-muted="status == 'cancelled'">
                <field name="contract_asset_ids" column_invisible="1"/>
                <field name="visit_date"/>
                <field name="contract_id"/>
                <field name="asset_id"/>
                <field name="visit_type" widget="badge"/>
                <field name="technician_name"/>
                <field name="is_covered_under_contract" widget="boolean_toggle" string="Covered"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-warning="status == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="action_asset_maintenance_contract" model="ir.actions.act_window">
        <field name="name">AMC Contracts</field>
        <field name="res_model">asset.maintenance.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_asset_contract_visits" model="ir.actions.act_window">
        <field name="name">Service Visits</field>
        <field name="res_model">asset.contract.service.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_asset_maintenance_team_list" model="ir.ui.view">
        <field name="name">asset.maintenance.team.list</field>
        <field name="model">asset.maintenance.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_leader_id" widget="many2one_avatar_user"/>
                <field name="active_tasks"/>
                <field name="availability_rate"/>
            </list>
        </field>
    </record>

    <record id="view_asset_maintenance_team_form" model="ir.ui.view">
        <field name="name">asset.maintenance.team.form</field>
        <field name="model">asset.maintenance.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="team_leader_id" widget="many2one_avatar_user"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="max_capacity"/>
                            <field name="active_tasks" readonly="1"/>
                            <field name="availability_rate" readonly="1"/>
                        </group>
                    </group>

                    <group string="Team Members">
                        <field name="member_ids" widget="many2many_tags"/>
                    </group>

                    <group>
                        <field name="skill_set"/>
                    </group>

                    <notebook>
                        <page string="Assigned Tasks">
                            <field name="task_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="asset_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Chatter">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_maintenance_task_search" model="ir.ui.view">
        <field name="name">asset.maintenance.task.search</field>
        <field name="model">asset.maintenance.task</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance Tasks">

                <field name="name"/>
                <field name="asset_id"/>
                <field name="assigned_user_id"/>
                <field name="maintenance_type"/>

                <filter string="Draft" name="flt_draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="flt_in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="flt_done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="flt_cancel" domain="[('state','=','cancel')]"/>

                <separator/>

                <filter string="Group by Asset" name="grp_asset" context="{'group_by':'asset_id'}"/>
                <filter string="Group by Type" name="grp_type" context="{'group_by':'maintenance_type'}"/>
                <filter string="Group by Assigned User" name="grp_user" context="{'group_by':'assigned_user_id'}"/>
                <filter string="Group by State" name="grp_state" context="{'group_by':'state'}"/>

                <separator/>

                <searchpanel>
                    <field name="asset_id" icon="fa-cube" select="multi"/>
                    <field name="assigned_user_id" icon="fa-user" select="multi"/>
                    <field name="maintenance_type" icon="fa-wrench" select="multi"/>
                    <field name="state" icon="fa-flag" select="multi"/>
                </searchpanel>

            </search>
        </field>
    </record>

    <record id="view_asset_maintenance_team_search" model="ir.ui.view">
        <field name="name">asset.maintenance.team.search</field>
        <field name="model">asset.maintenance.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_leader_id"/>
            </search>
        </field>
    </record>

    <record id="cron_flag_expiring_contracts" model="ir.cron">
        <field name="name">AMC: Flag Expiring Contracts</field>
        <field name="model_id" ref="model_asset_maintenance_contract"/>
        <field name="state">code</field>
        <field name="code">model.cron_flag_expiring_contracts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="action_asset_maintenance_team" model="ir.actions.act_window">
        <field name="name">Maintenance Teams</field>
        <field name="res_model">asset.maintenance.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_maintenance_team_search"/>
    </record>

    <record id="action_asset_maintenance_task" model="ir.actions.act_window">
        <field name="name">Maintenance Tasks</field>
        <field name="res_model">asset.maintenance.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_maintenance_task_search"/>
    </record>
</odoo>
