<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_asset_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.asset.inspection</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">


                <button name="action_view_maintenance_task"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="maintenance_task_id == False"
                groups="asset_management.group_asset_inspector,asset_management.group_asset_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="maintenance_task_count"/>
                        </span>
                        <span class="o_stat_text">Maintenance</span>
                    </div>
                </button>

            </xpath>

            <xpath expr="//header" position="inside">

                <!-- "Schedule Inspection" button is kept with same name for backward compat
                     but now opens the new asset.schedule.task.wizard -->
                <button name="action_schedule_inspection"
                        string="Schedule Task"
                        type="object"
                        class="btn-primary"
                        invisible="maintenance_task_id != False"
                        groups="asset_management.group_asset_ticket_manager,asset_management.group_asset_manager"/>
                />

            </xpath>

            <xpath expr="//sheet//group[1]" position="after">
                <group string="Asset &amp; Maintenance" name="asset_group">
                    <group>
                        <field name="asset_id"/>
                        <field name="cafm_ticket_id"
                               readonly="1"
                               invisible="cafm_ticket_id == False"/>
                        <field name="manager_approval_state"
                               readonly="1"
                               widget="badge"
                               invisible="not manager_approval_state"
                               decoration-warning="manager_approval_state == 'waiting_manager_approval'"
                               decoration-success="manager_approval_state == 'approved'"
                               decoration-danger="manager_approval_state == 'denied'"/>
                        <field name="manager_id" readonly="1" invisible="not manager_id"/>
                        <field name="maintenance_task_id"
                               readonly="1"
                               invisible="maintenance_task_id == False"/>
                    </group>
                    <group/>

                    <!-- AMC Contract Info — shown only when asset is linked to a contract -->
                    <group string="AMC Contract" invisible="not contract_id">
                        <group>
                            <field name="contract_name"
                                   readonly="1"
                                   string="Contract Name"/>
                            <field name="contract_reference"
                                   readonly="1"
                                   string="Contract Reference"
                                   invisible="not contract_reference"/>
                        </group>
                        <group>
                            <field name="contract_id"
                                   readonly="1"
                                   string="Contract"
                                   options="{'no_open': False}"/>
                        </group>
                    </group>

                </group>
            </xpath>

        </field>
    </record>
</odoo>
