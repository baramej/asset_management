<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hr_sync_employee_company" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hr.sync.employee.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rental_management_hr_sync.res_config_settings_view_form_hr_sync"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='rental_management_hr_sync']" position="inside">
                <setting string="Create Employees Under"
                         help="New employees fetched from the legacy HR system are created under this company (e.g. SBG). Empty: the company that carries the code.">
                    <field name="hr_sync_employee_company_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>