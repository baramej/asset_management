<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_asset_job_order" model="ir.sequence">
        <field name="name">Asset Job Order</field>
        <field name="code">asset.job.order</field>
        <field name="prefix">JO-</field>
        <field name="padding">5</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FORM VIEW  (unchanged — included for completeness)
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_asset_job_order_form" model="ir.ui.view">
        <field name="name">asset.job.order.form</field>
        <field name="model">asset.job.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request_material"
                            string="Request Material"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>

                    <button name="action_start"
                            string="Start Work"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'material_approved']"/>

                    <button name="action_end_work"
                            string="End Work"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress' or is_outsourced"/>
                    <button name="action_wait_outsource"
                            string="Waiting for Outsource Completion"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('draft', 'material_approved', 'in_progress') or not is_outsourced"/>

                    <button name="action_complete_outsource"
                            string="Complete Outsourced Job"
                            type="object"
                            class="btn-success"
                            invisible="state != 'waiting_outsource'"/>


                    <button name="action_approve"
                            string="Approve Job"
                            type="object"
                            class="btn-success"
                            invisible="state != 'done' or not customer_approval"/>

                    <button name="action_approve"
                            string="Approve &amp; Close"
                            type="object"
                            class="btn-success"
                            invisible="state != 'done' or customer_approval"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'done'"/>

                    <button name="action_close"
                            string="Close &amp; Sign"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved' or not customer_approval"/>

                    <button name="action_send_signature_email"
                            string="Send for Signature"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('approved', 'done') or signature_state == 'signed'"/>

                    <field name="signature_state"
                           widget="badge"
                           decoration-info="signature_state == 'pending'"
                           decoration-warning="signature_state == 'sent'"
                           decoration-success="signature_state == 'signed'"
                           invisible="signature_state == 'pending'"/>

                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('approved', 'closed') or invoice_id != False"/>

                    <button name="action_print_report"
                            string="Print Report"
                            type="object"
                            icon="fa-print"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,request_material,material_approved,in_progress,waiting_outsource,done,approved,closed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_maintenance_task"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                invisible="maintenance_task_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Maintenance Task</span>
                            </div>
                        </button>

                        <button name="action_view_helpdesk_ticket"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-ticket"
                                invisible="helpdesk_ticket_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">1</span>
                                <span class="o_stat_text">Ticket</span>
                            </div>
                        </button>

                        <button name="action_view_pending_returns"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-undo"
                                invisible="pending_return_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="pending_return_count"/>
                                </span>
                                <span class="o_stat_text">To Return</span>
                            </div>
                        </button>

                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-invoice"
                                invisible="invoice_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="invoice_count"/>
                                </span>
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Job Details">
                            <field name="maintenance_task_id" readonly="1"/>
                            <field name="asset_id" readonly="1"/>
                            <field name="helpdesk_ticket_id" readonly="1"
                                   invisible="helpdesk_ticket_id == False"/>
                            <field name="scheduled_date" readonly="1"/>
                        </group>
                        <group string="Assignment">
                            <field name="assigned_user_id"/>
                            <field name="maintenance_team_id"/>
                            <field name="findings_completion_rate" readonly="1"/>
                        </group>
                        <group string="Billing">
                            <field name="billing_partner_id"/>
                            <field name="labour_rate"/>
                            <field name="is_outsourced"
                                   widget="boolean_toggle"
                                   string="Outsource Job?"/>
                            <field name="outsource_vendor_id"
                                   invisible="not is_outsourced"
                                   options="{'no_create': True}"/>
                            <field name="outsource_reference"
                                   invisible="not is_outsourced"/>
                            <field name="customer_approval"
                                   widget="boolean_toggle"
                                   string="Customer Approval Required"/>
                            <field name="invoice_state"
                                   widget="badge"
                                   decoration-success="invoice_state == 'paid'"
                                   decoration-warning="invoice_state == 'partial'"
                                   decoration-secondary="invoice_state == 'not_paid'"
                                   decoration-danger="invoice_state == 'not_paid'"
                                   invisible="invoice_id == False"/>
                        </group>
                    </group>

                    <group>
                        <group string="Time Tracking">
                            <field name="start_datetime" readonly="1"/>
                            <field name="end_datetime" readonly="1"/>
                            <field name="total_hours" readonly="1" widget="float_time"/>
                        </group>
                        <group string="Closure"
                               invisible="state not in ['approved', 'closed']">
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="approved_by_name" readonly="1"
                                   invisible="approved_by_name == False"/>
                            <field name="approved_by_signature"
                                   widget="image"
                                   readonly="1"
                                   invisible="approved_by_signature == False"
                                   options="{'size': [200, 80]}"/>
                            <field name="closed_by_name" readonly="1"
                                   invisible="closed_by_name == False or not customer_approval"/>
                            <field name="closed_date" readonly="1"
                                   invisible="closed_date == False or not customer_approval"/>
                            <field name="closed_by_signature"
                                   widget="image"
                                   readonly="1"
                                   invisible="closed_by_signature == False or not customer_approval"
                                   options="{'size': [200, 80]}"/>
                        </group>
                    </group>

                    <group string="Customer Signature"
                           invisible="signature_state != 'signed'">
                        <field name="portal_signed_by" readonly="1"/>
                        <field name="portal_signed_on" readonly="1"/>
                        <field name="portal_signed_ip" readonly="1" optional="show"/>
                        <field name="portal_signature"
                               widget="image"
                               readonly="1"
                               options="{'size': [300, 100]}"
                               invisible="not portal_signature"/>
                    </group>

                    <notebook>
                        <page string="Findings" name="findings">
                            <field name="finding_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_from_inspection"
                                           readonly="1"
                                           widget="boolean_toggle"
                                           optional="show"/>
                                    <field name="description"
                                           string="Finding"
                                           required="1"/>
                                    <field name="notes"
                                           string="Notes"
                                           optional="show"/>
                                    <field name="severity"
                                           widget="badge"
                                           decoration-danger="severity == 'critical'"
                                           decoration-warning="severity == 'high'"
                                           decoration-info="severity == 'medium'"
                                           decoration-secondary="severity == 'low'"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'done'"
                                           decoration-danger="status == 'cannot_fix'"
                                           decoration-warning="status == 'in_progress'"
                                           decoration-secondary="status == 'pending'"/>
                                    <field name="technician_note" optional="show"/>
                                    <field name="image"
                                           widget="image"
                                           options="{'size': [38, 38]}"
                                           string="Photo"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="description"
                                                   placeholder="Describe the finding..."/>
                                            <field name="severity"/>
                                            <field name="status"/>
                                            <field name="is_from_inspection" readonly="1"/>
                                            <field name="technician_note"
                                                   placeholder="Technician remarks..."/>
                                            <field name="notes"
                                                   placeholder="Additional details..."/>
                                        </group>
                                        <group>
                                            <field name="image"
                                                   widget="image"
                                                   options="{'size': [300, 300]}"/>
                                        </group>
                                    </group>
                                    <group string="Additional Photos">
                                        <field name="image_1" widget="image"
                                               options="{'size': [200, 200]}"/>
                                        <field name="image_2" widget="image"
                                               options="{'size': [200, 200]}"/>
                                        <field name="image_3" widget="image"
                                               options="{'size': [200, 200]}"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Materials" name="materials">
                            <field name="material_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="is_consumable"
                                           string="Consumable"
                                           widget="boolean_toggle"
                                           readonly="1"
                                           decoration-success="is_consumable == True"
                                           decoration-warning="is_consumable == False"/>
                                    <field name="description"/>
                                    <field name="quantity_requested" string="Qty Planned"/>
                                    <field name="quantity_used"
                                           string="Qty Used"
                                           invisible="approval_state not in ('collected', 'consumed', 'pending_return', 'returned', 'consumed')"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="qty_reserved"
                                           string="Reserved"
                                           readonly="1"
                                           decoration-success="qty_reserved >= quantity_requested"
                                           decoration-warning="qty_reserved &gt; 0 and qty_reserved &lt; quantity_requested"
                                           decoration-danger="qty_reserved == 0 and approval_state == 'approved'"/>
                                    <field name="picking_id"
                                           string="Reservation"
                                           readonly="1"
                                           optional="show"/>
                                    <field name="source" readonly="1" optional="show"/>
                                    <field name="approval_state"
                                           widget="badge"
                                           decoration-info="approval_state == 'requested'"
                                           decoration-warning="approval_state in ('approved', 'collected')"
                                           decoration-success="approval_state == 'consumed'"
                                           decoration-danger="approval_state == 'rejected'"
                                           decoration-muted="approval_state == 'returned'"
                                           decoration-secondary="approval_state == 'pending_return'"
                                           readonly="1"/>
                                    <field name="approved_by" readonly="1" optional="show"/>
                                    <field name="rejection_reason" readonly="1" optional="show"/>
                                    <button name="action_approve"
                                            string="Approve"
                                            type="object"
                                            icon="fa-check"
                                            class="btn-success btn-sm"
                                            invisible="approval_state != 'requested'"
                                            groups="asset_management.group_asset_storekeeper"/>
                                    <button name="action_reject"
                                            string="Reject"
                                            type="object"
                                            icon="fa-times"
                                            class="btn-danger btn-sm"
                                            invisible="approval_state != 'requested'"
                                            groups="asset_management.group_asset_storekeeper"/>
                                    <button name="action_mark_collected"
                                            string="Collect"
                                            type="object"
                                            icon="fa-sign-in"
                                            class="btn-primary btn-sm"
                                            invisible="approval_state != 'approved'"/>
                                    <button name="action_return_unused"
                                            string="Return"
                                            type="object"
                                            icon="fa-undo"
                                            class="btn-secondary btn-sm"
                                            invisible="approval_state not in ('collected', 'approved')"
                                            title="Return this material back to stock"/>
                                    <button name="action_confirm_return"
                                            string="Confirm Return"
                                            type="object"
                                            icon="fa-check-circle"
                                            class="btn-warning btn-sm"
                                            invisible="approval_state != 'pending_return'"
                                            title="Confirm equipment has been returned to store"
                                            groups="asset_management.group_asset_storekeeper"/>
                                </list>
                            </field>
                        </page>

                        <page string="Time Logs" name="time_logs">
                            <field name="technician_log_ids">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="date"/>
                                    <field name="clock_in"
                                           string="Clock In"
                                           widget="float_time"/>
                                    <field name="clock_out"
                                           string="Clock Out"
                                           widget="float_time"/>
                                    <field name="hours"
                                           string="Total Hours"
                                           widget="float_time"
                                           readonly="1"
                                           decoration-muted="hours == 0"
                                           decoration-success="hours > 0"/>
                                    <field name="activity"
                                           placeholder="What was done..."/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_hours"
                                       string="Total Hours Worked"
                                       widget="float_time"
                                       readonly="1"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <group string="Technician Notes">
                                <field name="technician_notes" nolabel="1"/>
                            </group>
                            <group string="Supervisor Close Notes"
                                   invisible="state not in ['approved', 'closed']">
                                <field name="supervisor_close_notes" nolabel="1"
                                       groups="asset_management.group_asset_supervisor"/>
                            </group>
                        </page>

                        <page string="Outsource" name="outsource"
                              invisible="not is_outsourced">
                            <group string="Outsource Details">
                                <field name="outsource_vendor_id"
                                       options="{'no_create': True}"/>
                                <field name="outsource_reference"/>
                            </group>
                            <group string="Vendor Documents">
                                <div class="alert alert-info" role="alert"
                                     invisible="outsource_attachment_ids">
                                    <i class="fa fa-info-circle"/>
                                    Attach the vendor's job order or completion certificate here.
                                    These are required before the outsourced job can be marked complete.
                                </div>
                                <field name="outsource_attachment_ids"
                                       nolabel="1"
                                       widget="many2many_binary"/>
                            </group>
                            <group string="Outsource Notes">
                                <field name="outsource_notes"
                                       nolabel="1"
                                       placeholder="Any notes about the outsourced work..."/>
                            </group>
                        </page>

                        <page string="Additional Services" name="additional_services">
                            <p style="color: var(--color-text-secondary); font-size: 13px; margin-bottom: 8px;">
                                Add any extra billable items not covered by labour or materials
                                (e.g. equipment hire, contractor charges, specialist call-out fees).
                            </p>
                            <field name="additional_service_ids">
                                <list editable="bottom">
                                    <field name="name" required="1"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Flat Checklist page for flat-type job orders -->
                        <page string="Flat Checklist" name="flat_checklist"
                              invisible="job_type != 'flat'">
                            <group>
                                <group>
                                    <field name="job_type" readonly="1" widget="badge"
                                           decoration-info="job_type == 'flat'"/>
                                    <field name="flat_asset_id" readonly="1"
                                           invisible="not flat_asset_id"/>
                                    <field name="flat_no" readonly="1"
                                           invisible="not flat_no"/>
                                    <field name="resident_name" readonly="1"
                                           invisible="not resident_name"/>
                                    <field name="checklist_template_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="checked_by"/>
                                    <field name="checklist_progress"
                                           widget="progressbar"
                                           options="{'editable': false}"
                                           invisible="checklist_total == 0"/>
                                </group>
                            </group>
                            <field name="flat_checklist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section" optional="show"/>
                                    <field name="description" readonly="1"/>
                                    <field name="expected_qty" readonly="1" optional="show"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'ok'"
                                           decoration-danger="status == 'missing' or status == 'damaged'"
                                           decoration-secondary="status == 'na'"/>
                                    <field name="remarks"/>
                                    <field name="is_meter_reading" readonly="1" optional="show"/>
                                    <field name="meter_value"
                                           invisible="not is_meter_reading"
                                           optional="show"/>
                                    <field name="meter_date"
                                           invisible="not is_meter_reading"
                                           optional="show"/>
                                </list>
                            </field>
                            <group string="Signatures">
                                <group>
                                    <field name="resident_signature" widget="signature"/>
                                    <field name="resident_signature_name"/>
                                </group>
                            </group>
                        </page>

                        <page string="Chatter">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         LIST VIEW  — enhanced with more columns
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_asset_job_order_list" model="ir.ui.view">
        <field name="name">asset.job.order.list</field>
        <field name="model">asset.job.order</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'"
                  decoration-success="state in ('approved','closed')"
                  decoration-warning="state == 'in_progress'"
                  decoration-muted="state == 'draft'">
                <field name="name" string="Job Order"/>
                <field name="asset_id"/>
                <field name="maintenance_task_id" optional="show"/>
                <field name="maintenance_team_id" optional="show"/>
                <field name="assigned_user_id" string="Assigned To" optional="show"/>
                <field name="billing_partner_id" string="Billing Entity" optional="show"/>
                <field name="scheduled_date" optional="show"/>
                <field name="start_datetime" string="Started" optional="hide"/>
                <field name="end_datetime" string="Ended" optional="hide"/>
                <field name="total_hours"
                       string="Hours"
                       widget="float_time"
                       optional="show"/>
                <field name="findings_completion_rate"
                       string="Completion %"
                       optional="show"/>
                <field name="invoice_id"
                       string="Invoice"
                       optional="show"/>
                <field name="invoice_state"
                       string="Payment"
                       widget="badge"
                       optional="show"/>
                <field name="pending_return_count"
                       string="Pending Returns"
                       optional="show"/>
                <field name="state"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEARCH VIEW  — enhanced filters, groupbys, and search panel
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_asset_job_order_search" model="ir.ui.view">
        <field name="name">asset.job.order.search</field>
        <field name="model">asset.job.order</field>
        <field name="arch" type="xml">
            <search string="Search Job Orders">

                <!-- ── Full-text fields ────────────────────────────────── -->
                <field name="name" string="Job Order"/>
                <field name="asset_id" string="Asset"/>
                <field name="maintenance_task_id" string="Maintenance Task"/>
                <field name="assigned_user_id" string="Assigned To"/>
                <field name="maintenance_team_id" string="Team"/>
                <field name="billing_partner_id" string="Billing Entity"/>

                <field name="helpdesk_ticket_id" string="Helpdesk Ticket"/>

                <!-- ── Status filters ─────────────────────────────────── -->
                <filter string="Draft" name="flt_draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Material Requested" name="flt_request_material"
                        domain="[('state','=','request_material')]"/>
                <filter string="Material Approved" name="flt_material_approved"
                        domain="[('state','=','material_approved')]"/>
                <filter string="In Progress" name="flt_in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="flt_done"
                        domain="[('state','=','done')]"/>
                <filter string="Approved" name="flt_approved"
                        domain="[('state','=','approved')]"/>
                <filter string="Closed" name="flt_closed"
                        domain="[('state','=','closed')]"/>
                <filter string="Rejected" name="flt_rejected"
                        domain="[('state','=','rejected')]"/>

                <separator/>

                <!-- ── Material / stock filters ───────────────────────── -->
                <filter string="Materials Pending" name="flt_mat_pending"
                        domain="[('material_line_ids.approval_state','=','requested')]"/>
                <filter string="Materials Approved" name="flt_mat_approved"
                        domain="[('material_line_ids.approval_state','=','approved')]"/>
                <filter string="Materials Rejected" name="flt_mat_rejected"
                        domain="[('material_line_ids.approval_state','=','rejected')]"/>
                <filter string="Has Pending Returns" name="flt_pending_returns"
                        domain="[('pending_return_count','&gt;',0)]"/>

                <separator/>

                <!-- ── Billing filters ────────────────────────────────── -->
                <filter string="Invoiced" name="flt_invoiced"
                        domain="[('invoice_id','!=',False)]"/>
                <filter string="Not Invoiced" name="flt_not_invoiced"
                        domain="[('invoice_id','=',False)]"/>
                <filter string="Invoice Paid" name="flt_invoice_paid"
                        domain="[('invoice_state','=','paid')]"/>
                <filter string="Invoice Unpaid" name="flt_invoice_unpaid"
                        domain="[('invoice_state','=','not_paid')]"/>
                <filter string="Invoice Partial" name="flt_invoice_partial"
                        domain="[('invoice_state','=','partial')]"/>
                <filter string="Has Billing Entity" name="flt_has_billing"
                        domain="[('billing_partner_id','!=',False)]"/>
                <filter string="No Billing Entity" name="flt_no_billing"
                        domain="[('billing_partner_id','=',False)]"/>
                <filter string="Customer Approval Required" name="flt_cust_approval"
                        domain="[('customer_approval','=',True)]"/>
                <filter string="Outsourced" name="flt_outsourced"
                        domain="[('is_outsourced','=',True)]"/>
                <filter string="Waiting Outsource" name="flt_waiting_outsource"
                        domain="[('state','=','waiting_outsource')]"/>

                <separator/>

                <!-- Completion % filters removed — findings_completion_rate is not stored -->

                <separator/>

                <!-- ── Origin filters ─────────────────────────────────── -->

                <filter string="Has Helpdesk Ticket" name="flt_has_ticket"
                        domain="[('helpdesk_ticket_id','!=',False)]"/>

                <separator/>

                <!-- ── Personal / date filters ───────────────────────── -->
                <filter string="My Jobs" name="flt_my_jobs"
                        domain="[('assigned_user_id','=',uid)]"/>

                <filter string="Scheduled This Month" name="flt_this_month"
                        domain="[
                            ('scheduled_date','&gt;=', (context_today()).strftime('%Y-%m-01')),
                            ('scheduled_date','&lt;',  (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))
                        ]"/>

                <filter string="Scheduled This Week" name="flt_this_week"
                        domain="[
                            ('scheduled_date','&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                            ('scheduled_date','&lt;',  (context_today() - relativedelta(days=context_today().weekday()) + relativedelta(weeks=1)).strftime('%Y-%m-%d'))
                        ]"/>

                <filter string="Overdue (In Progress)" name="flt_overdue"
                        domain="[('state','=','in_progress'),('scheduled_date','&lt;', context_today().strftime('%Y-%m-%d'))]"/>

                <separator/>

                <!-- ── Group By ───────────────────────────────────────── -->
                <filter string="Group by Status" name="grp_state"
                        context="{'group_by':'state'}"/>
                <filter string="Group by Asset" name="grp_asset"
                        context="{'group_by':'asset_id'}"/>
                <filter string="Group by Team" name="grp_team"
                        context="{'group_by':'maintenance_team_id'}"/>
                <filter string="Group by Assigned To" name="grp_user"
                        context="{'group_by':'assigned_user_id'}"/>
                <filter string="Group by Billing Entity" name="grp_billing"
                        context="{'group_by':'billing_partner_id'}"/>
                <filter string="Group by Scheduled Date" name="grp_scheduled_date"
                        context="{'group_by':'scheduled_date:month'}"/>

                <filter string="Group by Invoice State" name="grp_invoice_state"
                        context="{'group_by':'invoice_state'}"/>

                <!-- ── Search Panel (sidebar) ─────────────────────────── -->
                <searchpanel>
                    <field name="maintenance_team_id"
                           string="Team"
                           icon="fa-users"
                           select="multi"/>
                    <field name="assigned_user_id"
                           string="Assigned To"
                           icon="fa-user"
                           select="multi"/>
                    <field name="billing_partner_id"
                           string="Billing Entity"
                           icon="fa-building"
                           select="multi"/>
                </searchpanel>

            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ACTIONS
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_asset_job_order_pending_returns" model="ir.actions.act_window">
        <field name="name">Job Order Pending Returns</field>
        <field name="res_model">asset.job.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pending_return_count', '>', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending returns</p>
            <p>Job Orders with equipment awaiting return to store will appear here.</p>
        </field>
    </record>

    <record id="action_asset_job_order" model="ir.actions.act_window">
        <field name="name">Job Orders</field>
        <field name="res_model">asset.job.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_job_order_search"/>
    </record>

</odoo>