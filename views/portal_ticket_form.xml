<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_helpdesk_ticket_form" name="New Helpdesk Ticket">
        <t t-call="portal.portal_layout">

            <div class="container mt-4 mb-5">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="card shadow-sm border-0">
                            <div class="card-header py-3"
                                 style="background: linear-gradient(135deg,#1a1a2e,#16213e); color:#fff;">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                         style="width:40px;height:40px;background:rgba(255,255,255,0.15)">
                                        <i class="fa fa-wrench fa-lg"/>
                                    </div>
                                    <div>
                                        <h5 class="mb-0">Submit a Service Request</h5>
                                        <small style="opacity:0.75">Fill in the details below and your selected approver will be
                                            notified for approval
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body p-4">

                                <style>
                                    .searchable-select { position: relative; }
                                    .searchable-select-dropdown {
                                    display: none;
                                    position: absolute;
                                    top: 100%;
                                    left: 0;
                                    right: 0;
                                    z-index: 1000;
                                    max-height: 220px;
                                    overflow-y: auto;
                                    background: #fff;
                                    border: 1px solid #ced4da;
                                    border-top: none;
                                    border-radius: 0 0 .375rem .375rem;
                                    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
                                    }
                                    .searchable-select-item {
                                    padding: 6px 12px;
                                    cursor: pointer;
                                    font-size: 14px;
                                    }
                                    .searchable-select-item:hover,
                                    .searchable-select-item.active {
                                    background: #f0f4ff;
                                    }
                                    .searchable-select-empty {
                                    padding: 6px 12px;
                                    font-size: 13px;
                                    }
                                </style>

                                <!-- Errors -->
                                <t t-if="error_message">
                                    <div class="alert alert-danger d-flex align-items-start" role="alert">
                                        <i class="fa fa-exclamation-triangle me-2 mt-1"/>
                                        <ul class="mb-0 ps-2">
                                            <li t-foreach="error_message" t-as="msg">
                                                <t t-out="msg"/>
                                            </li>
                                        </ul>
                                    </div>
                                </t>

                                <form action="/my/tickets/new" method="post" id="portal_ticket_form">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>

                                    <!-- ── SECTION: Organisation (locked, auto-filled) ── -->
                                    <div class="border-bottom pb-2 mb-3">
                                        <h6 class="text-uppercase text-muted fw-bold"
                                            style="font-size:11px;letter-spacing:1px">
                                            <i class="fa fa-building me-1"/>Organisation
                                        </h6>
                                    </div>

                                    <div class="row mb-4">
                                        <div class="col-md-6 mb-3 mb-md-0">
                                            <label class="form-label fw-bold">Company</label>
                                            <input type="text" class="form-control" disabled="disabled"
                                                   t-att-value="display_company_name or ''"/>
                                            <!-- Server always recomputes this from the logged-in user; hidden field kept only for UX round-trip -->
                                            <input type="hidden" name="company_id"
                                                   t-att-value="user_company.id if user_company else ''"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">Department</label>
                                            <input type="text" class="form-control" disabled="disabled"
                                                   t-att-value="user_department.name if user_department else '—'"/>
                                            <input type="hidden" name="department_id"
                                                   t-att-value="user_department.id if user_department else ''"/>
                                        </div>
                                    </div>

                                    <!-- ── SECTION: Location ── -->
                                    <div class="border-bottom pb-2 mb-3">
                                        <h6 class="text-uppercase text-muted fw-bold"
                                            style="font-size:11px;letter-spacing:1px">
                                            <i class="fa fa-map-marker me-1"/>Location
                                        </h6>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4 mb-3 mb-md-0">
                                            <label class="form-label fw-bold" for="location_id">Main Location</label>
                                            <select name="location_id" id="location_id"
                                                    class="form-select"
                                                    onchange="onLocationChange(this.value)">
                                                <option value="">— Select Location —</option>
                                                <t t-foreach="locations" t-as="loc">
                                                    <option t-att-value="loc.id"
                                                            t-att-selected="str(post.get('location_id','')) == str(loc.id) if post else ''">
                                                        <t t-out="loc.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-4 mb-3 mb-md-0">
                                            <label class="form-label fw-bold" for="sublocation_id">Sub-location</label>
                                            <select name="sublocation_id" id="sublocation_id" class="form-select">
                                                <option value="">— Select Sub-location —</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold" for="building">Unit / Room</label>
                                            <input type="text" name="building" id="building"
                                                   class="form-control"
                                                   t-att-value="post.get('building', '') if post else ''"
                                                   placeholder="e.g. Room 101, Villa 5"/>
                                        </div>
                                    </div>

                                    <!-- Asset location auto-fill banner -->
                                    <div class="row mb-4" id="asset_location_row" style="display:none">
                                        <div class="col-12">
                                            <div class="alert alert-info py-2 mb-0 d-flex align-items-center">
                                                <i class="fa fa-map-marker me-2"/>
                                                <span>
                                                    <strong>Asset Location:</strong>
                                                    <span id="asset_location_display" class="ms-1">—</span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ── SECTION: Equipment ── -->
                                    <div class="border-bottom pb-2 mb-3">
                                        <h6 class="text-uppercase text-muted fw-bold"
                                            style="font-size:11px;letter-spacing:1px">
                                            <i class="fa fa-cog me-1"/>Equipment
                                        </h6>
                                    </div>

                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold" for="asset_id">Equipment / Asset</label>
                                            <select name="asset_id" id="asset_id"
                                                    class="form-select"
                                                    onchange="onAssetChange(this.value)">
                                                <option value="">— Select Equipment —</option>
                                                <t t-foreach="assets" t-as="asset">
                                                    <option t-att-value="asset.id"
                                                            t-att-data-location-id="asset.location_id.id or ''"
                                                            t-att-data-location-name="asset.location_id.name or ''"
                                                            t-att-selected="str(post.get('asset_id','')) == str(asset.id) if post else ''">
                                                        <t t-out="asset.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            <div class="form-text text-muted">
                                                <i class="fa fa-info-circle me-1"/>
                                                Selecting an asset will auto-fill the location above.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ── SECTION: Request Details ── -->
                                    <div class="border-bottom pb-2 mb-3">
                                        <h6 class="text-uppercase text-muted fw-bold"
                                            style="font-size:11px;letter-spacing:1px">
                                            <i class="fa fa-info-circle me-1"/>Request Details
                                        </h6>
                                    </div>

                                    <!-- Subject + Priority on same row -->
                                    <div class="row mb-3">
                                        <div class="col-md-9 mb-3 mb-md-0">
                                            <label class="form-label fw-bold" for="name">
                                                Subject
                                                <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" name="name" id="name"
                                                   t-att-class="'form-control is-invalid' if error.get('name') else 'form-control'"
                                                   t-att-value="post.get('name', '') if post else ''"
                                                   placeholder="Brief description of the issue"/>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold">Priority</label>
                                            <div class="d-flex align-items-center" style="height:38px">
                                                <div class="portal-priority-stars d-flex gap-1">
                                                    <input type="hidden" name="priority" id="priority_value"
                                                           t-att-value="post.get('priority','0') if post else '0'"/>
                                                    <i class="fa fa-star portal-star fa-lg"
                                                       data-val="1" style="cursor:pointer;color:#dee2e6"/>
                                                    <i class="fa fa-star portal-star fa-lg"
                                                       data-val="2" style="cursor:pointer;color:#dee2e6"/>
                                                    <i class="fa fa-star portal-star fa-lg"
                                                       data-val="3" style="cursor:pointer;color:#dee2e6"/>
                                                </div>
                                            </div>
                                            <small class="text-muted" id="priority_label">Normal</small>
                                        </div>
                                    </div>

                                    <!-- Job Category -->
                                    <div class="row mb-3">
                                        <div class="col-md-6 mb-3 mb-md-0">
                                            <label class="form-label fw-bold" for="job_category_id">
                                                Job Category
                                                <span class="text-danger">*</span>
                                            </label>
                                            <select name="job_category_id" id="job_category_id"
                                                    t-att-class="'form-select is-invalid' if error.get('job_category_id') else 'form-select'">
                                                <option value="">— Select Category —</option>
                                                <t t-foreach="job_categories" t-as="cat">
                                                    <option t-att-value="cat.id"
                                                            t-att-selected="str(post.get('job_category_id','')) == str(cat.id) if post else ''">
                                                        <t t-out="cat.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <div class="row mb-4">
                                        <div class="col-12">
                                            <label class="form-label fw-bold" for="description">
                                                Description
                                                <span class="text-danger">*</span>
                                            </label>
                                            <textarea name="description" id="description" rows="4"
                                                      t-att-class="'form-control is-invalid' if error.get('description') else 'form-control'"
                                                      placeholder="Describe the issue — when it started, how often it occurs, any error messages, etc.">
                                                <t t-out="post.get('description','') if post else ''"/>
                                            </textarea>
                                        </div>
                                    </div>

                                    <!-- ── SECTION: Approval ── -->
                                    <div class="border-bottom pb-2 mb-3">
                                        <h6 class="text-uppercase text-muted fw-bold"
                                            style="font-size:11px;letter-spacing:1px">
                                            <i class="fa fa-user-check me-1"/>Approval
                                        </h6>
                                    </div>

                                    <div class="row mb-4">
                                        <t t-if="approvers">
                                            <div class="col-md-8">
                                                <label class="form-label fw-bold" for="portal_approver_id">
                                                    Approver
                                                    <span class="text-danger">*</span>
                                                </label>
                                                <select name="portal_approver_id" id="portal_approver_id"
                                                        t-att-class="'form-select is-invalid' if error.get('portal_approver_id') else 'form-select'">
                                                    <option value="">— Select Approver —</option>
                                                    <t t-foreach="approvers" t-as="appr">
                                                        <option t-att-value="appr.id"
                                                                t-att-selected="selected_approver_id == str(appr.id)">
                                                            <t t-out="appr.display_name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <div class="form-text text-muted">
                                                    <i class="fa fa-info-circle me-1"/>
                                                    Search by name, employee code, department name or department code.
                                                    Your request is emailed to this person for approval.
                                                </div>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="col-12">
                                                <div class="alert py-2 mb-0 text-muted"
                                                     style="background:#f8f9ff;border:1px solid #e0e4ff;border-radius:8px;font-size:13px">
                                                    <i class="fa fa-info-circle me-1"/>
                                                    No approver list is configured — the request will follow the
                                                    standard approval route.
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <!-- Submit -->
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a href="/my/home" class="btn btn-outline-secondary px-4">
                                            <i class="fa fa-times me-1"/>Cancel
                                        </a>
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="fa fa-paper-plane me-1"/>Submit Request
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
                //<![CDATA[
(function () {
    // ── Priority stars ───────────────────────────────────────────────────
    var PRIORITY_LABELS = {0: "Normal", 1: "Low", 2: "High", 3: "Very High"};
    var currentPriority = parseInt(document.getElementById("priority_value").value) || 0;

    function renderStars(val) {
        document.querySelectorAll(".portal-star").forEach(function (s) {
            var sv = parseInt(s.dataset.val);
            s.style.color = sv <= val ? "#f6a623" : "#dee2e6";
        });
        document.getElementById("priority_label").textContent = PRIORITY_LABELS[val] || "Normal";
        document.getElementById("priority_value").value = val;
        currentPriority = val;
    }

    document.querySelectorAll(".portal-star").forEach(function (star) {
        star.addEventListener("click", function () {
            var val = parseInt(this.dataset.val);
            renderStars(val === currentPriority ? 0 : val);
        });
        star.addEventListener("mouseenter", function () {
            var val = parseInt(this.dataset.val);
            document.querySelectorAll(".portal-star").forEach(function (s) {
                s.style.color = parseInt(s.dataset.val) <= val ? "#f6a623" : "#dee2e6";
            });
        });
        star.addEventListener("mouseleave", function () {
            renderStars(currentPriority);
        });
    });

    renderStars(currentPriority);

    // ── JSON-RPC helper ──────────────────────────────────────────────────
    function callJSON(url, params, cb) {
        fetch(url, {
            method: "POST",
            headers: {"Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest"},
            body: JSON.stringify({jsonrpc: "2.0", method: "call", id: 1, params: params}),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) { cb(data.result); })
        .catch(function (e) { console.error(url, e); });
    }

    // ── Searchable select wrapper ───────────────────────────────────────────
    function makeSearchable(selectEl, placeholder) {
        if (!selectEl || selectEl.dataset.searchableInit) return;
        selectEl.dataset.searchableInit = "1";
        selectEl.style.display = "none";

        var wrap = document.createElement("div");
        wrap.className = "searchable-select";
        selectEl.parentNode.insertBefore(wrap, selectEl);
        wrap.appendChild(selectEl);

        var input = document.createElement("input");
        input.type = "text";
        input.className = "form-control";
        input.autocomplete = "off";
        input.placeholder = placeholder || "Type to search...";
        if (selectEl.classList.contains("is-invalid")) input.classList.add("is-invalid");
        wrap.insertBefore(input, selectEl);

        var dropdown = document.createElement("div");
        dropdown.className = "searchable-select-dropdown";
        wrap.appendChild(dropdown);

        function selectedText() {
            var opt = selectEl.options[selectEl.selectedIndex];
            return (opt && opt.value) ? opt.text : "";
        }

        function buildList(filterText) {
            dropdown.innerHTML = "";
            // Every typed word must appear somewhere in the option, in any order
            // (e.g. "kia 10768" or "sushil sales").
            var terms = (filterText || "").toLowerCase().split(/\s+/).filter(Boolean);
            var any = false;
            Array.prototype.forEach.call(selectEl.options, function (opt) {
                if (!opt.value) return;
                var text = opt.text.toLowerCase();
                if (terms.some(function (t) { return text.indexOf(t) === -1; })) return;
                any = true;
                var item = document.createElement("div");
                item.className = "searchable-select-item" + (opt.value === selectEl.value ? " active" : "");
                item.textContent = opt.text;
                item.addEventListener("mousedown", function (e) {
                    e.preventDefault();
                    selectEl.value = opt.value;
                    input.value = opt.text;
                    dropdown.style.display = "none";
                    selectEl.dispatchEvent(new Event("change"));
                });
                dropdown.appendChild(item);
            });
            if (!any) {
                var empty = document.createElement("div");
                empty.className = "searchable-select-empty text-muted";
                empty.textContent = "No results";
                dropdown.appendChild(empty);
            }
        }

        input.addEventListener("focus", function () {
            buildList("");
            dropdown.style.display = "block";
        });
        input.addEventListener("input", function () {
            buildList(input.value);
            dropdown.style.display = "block";
        });
        input.addEventListener("blur", function () {
            setTimeout(function () {
                dropdown.style.display = "none";
                input.value = selectedText();
            }, 150);
        });

        input.value = selectedText();

        // Exposed so callers can refresh the visible text after options are
        // repopulated via AJAX (e.g. location -> sublocation, location -> assets)
        selectEl._searchableRefresh = function () {
            input.value = selectedText();
        };
    }

    // ── Location change — load sub-locations ─────────────────────────────
    var suppressAssetReload = false;

    function onLocationChange(locId) {
        var subSel = document.getElementById("sublocation_id");
        subSel.innerHTML = '<option value="">— Select Sub-location —</option>';
        subSel.onchange = function () { onSublocationChange(subSel.value); };

        if (locId) {
            callJSON("/my/tickets/sublocations", {parent_id: parseInt(locId)}, function (locs) {
                (locs || []).forEach(function (l) {
                    subSel.innerHTML += '<option value="' + l.id + '">' + l.name + '</option>';
                });
                if (subSel._searchableRefresh) subSel._searchableRefresh();   // <-- add
            });
        } else if (subSel._searchableRefresh) {
            subSel._searchableRefresh();   // <-- add
        }

        if (!suppressAssetReload) {
    reloadAssets(locId, null, null);
     }
    }
    window.onLocationChange = onLocationChange;

    function onSublocationChange(subId) {
    if (!suppressAssetReload) {
        var locId = document.getElementById("location_id").value;
        var previousAssetId = document.getElementById("asset_id").value;
        reloadAssets(locId, subId, previousAssetId);
    }
}

    function reloadAssets(locationId, sublocationId, preserveAssetId) {
    callJSON("/my/tickets/assets_by_location",
        {location_id: locationId ? parseInt(locationId) : null,
         sublocation_id: sublocationId ? parseInt(sublocationId) : null},
        function (assets) {
            var sel = document.getElementById("asset_id");
            sel.innerHTML = '<option value="">— Select Equipment —</option>';
            (assets || []).forEach(function (a) {
                var opt = document.createElement("option");
                opt.value = a.id;
                opt.text = a.name;
                opt.dataset.locationId   = a.location_id   || "";
                opt.dataset.locationName = a.location_name || "";
                sel.appendChild(opt);
            });
            if (preserveAssetId) sel.value = preserveAssetId;
            if (sel._searchableRefresh) sel._searchableRefresh();
        }
    );
}

    // ── Asset change — auto-fill location (without re-filtering itself away) ──
    function onAssetChange(assetId) {
        if (!assetId) { clearAssetLocation(); return; }
        var sel  = document.getElementById("asset_id");
        var opt  = sel.options[sel.selectedIndex];
        var locId   = opt.dataset.locationId   || "";
        var locName = opt.dataset.locationName || "";

        if (locName) {
            document.getElementById("asset_location_display").textContent = locName;
            document.getElementById("asset_location_row").style.display = "";
        } else {
            clearAssetLocation();
        }

        if (locId) {
            var locSel = document.getElementById("location_id");
            suppressAssetReload = true; // picking the asset drives the location, not the other way around
            for (var i = 0; i < locSel.options.length; i++) {
                if (locSel.options[i].value == locId) {
                    locSel.selectedIndex = i;
                    onLocationChange(locId);
                    break;
                }
            }
            suppressAssetReload = false;
        }
    }
    window.onAssetChange = onAssetChange;

    function clearAssetLocation() {
        document.getElementById("asset_location_display").textContent = "—";
        document.getElementById("asset_location_row").style.display = "none";
    }

    // ── Init on load ─────────────────────────────────────────────────────
    document.addEventListener("DOMContentLoaded", function () {
        makeSearchable(document.getElementById("location_id"), "Search location...");
        makeSearchable(document.getElementById("sublocation_id"), "Search sub-location...");
        makeSearchable(document.getElementById("asset_id"), "Search equipment...");
        makeSearchable(document.getElementById("portal_approver_id"),
                       "Type name, emp code, department...");

        var locSel = document.getElementById("location_id");
        if (locSel && locSel.value) onLocationChange(locSel.value);

        var assSel = document.getElementById("asset_id");
        if (assSel && assSel.value) onAssetChange(assSel.value);
    });
})();
//]]>
            </script>
        </t>
    </template>

    <!-- ── Success page ─────────────────────────────────────────────────────── -->
    <template id="portal_helpdesk_ticket_submitted" name="Ticket Submitted">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <div class="mb-4">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width:80px;height:80px;background:#e6f9f0">
                                <i class="fa fa-check fa-2x text-success"/>
                            </div>
                            <h4 class="fw-bold">Request Submitted Successfully</h4>
                            <p class="text-muted">
                                Your service request is now <strong>pending approval</strong> by your selected approver.
                                You will receive an email notification once it has been reviewed.
                            </p>
                        </div>
                        <a href="/my/home" class="btn btn-primary me-2">
                            <i class="fa fa-home me-1"/>Back to Home
                        </a>
                        <a href="/my/tickets/new" class="btn btn-outline-primary">
                            <i class="fa fa-plus me-1"/>Submit Another
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── My Home link ─────────────────────────────────────────────────────── -->
    <template id="portal_my_home_ticket_link" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
            <style>
                .o_portal_ticket_tile {
                background-color: #f8f9fa;
                transition: box-shadow .15s ease-in-out, transform .15s ease-in-out;
                }
                .o_portal_ticket_tile:hover {
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
                transform: translateY(-2px);
                text-decoration: none;
                }
            </style>
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-3">
                <a href="/my/tickets/new"
                   class="o_portal_doc_item o_portal_ticket_tile d-flex align-items-center p-3 rounded shadow-sm text-decoration-none">
                    <span class="o_portal_doc_icon d-flex align-items-center justify-content-center rounded-circle me-3 flex-shrink-0"
                          style="width:48px;height:48px;background-color:#e7f1ff;">
                        <i class="fa fa-wrench fa-lg" style="color:#714B67;"/>
                    </span>
                    <span>
                        <span class="o_portal_doc_name d-block fw-bold text-dark">Submit a Service Request</span>
                        <small class="text-muted">Report an issue or request maintenance</small>
                    </span>
                </a>
            </div>
            <t t-set="my_request_count"
               t-value="request.env['helpdesk.ticket'].sudo().search_count([('partner_id', '=', request.env.user.partner_id.id)])"/>
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 mb-3">
                <a href="/my/service-requests"
                   class="o_portal_doc_item o_portal_ticket_tile d-flex align-items-center p-3 rounded shadow-sm text-decoration-none">
                    <span class="o_portal_doc_icon d-flex align-items-center justify-content-center rounded-circle me-3 flex-shrink-0"
                          style="width:48px;height:48px;background-color:#e7f1ff;">
                        <i class="fa fa-list-alt fa-lg" style="color:#714B67;"/>
                    </span>
                    <span class="flex-grow-1">
                        <span class="o_portal_doc_name d-block fw-bold text-dark">My Service Requests</span>
                        <small class="text-muted">Track the requests you have submitted</small>
                    </span>
                    <span class="badge rounded-pill text-bg-secondary ms-2" t-out="my_request_count"/>
                </a>
            </div>
        </xpath>
    </template>
    <!-- ── My Service Requests: list ───────────────────────────────────────── -->
    <template id="portal_my_service_requests" name="My Service Requests">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">My Service Requests</h4>
                    <a href="/my/tickets/new" class="btn btn-primary">
                        <i class="fa fa-plus me-1"/>New Request
                    </a>
                </div>
                <t t-if="not tickets">
                    <div class="alert alert-info">You have not submitted any service requests yet.</div>
                </t>
                <div t-else="" class="table-responsive">
                    <table class="table table-hover align-middle bg-white shadow-sm rounded">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Subject</th>
                                <th>Submitted</th>
                                <th>Approval</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="tickets" t-as="ticket">
                                <td>
                                    <a t-attf-href="/my/service-requests/{{ ticket.id }}">#
                                        <t t-out="ticket.id"/>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/service-requests/{{ ticket.id }}" t-out="ticket.name"/>
                                </td>
                                <td>
                                    <span t-field="ticket.create_date" t-options="{'widget': 'date'}"/>
                                </td>
                                <td>
                                    <span t-if="ticket.manager_approval_state == 'waiting_manager_approval'"
                                          class="badge text-bg-warning">Waiting for manager
                                    </span>
                                    <span t-elif="ticket.manager_approval_state == 'approved'"
                                          class="badge text-bg-success">Approved
                                    </span>
                                    <span t-elif="ticket.manager_approval_state == 'denied'"
                                          class="badge text-bg-danger">Denied
                                    </span>
                                    <span t-else="" class="text-muted">—</span>
                                </td>
                                <td>
                                    <span class="badge text-bg-light border" t-out="ticket.stage_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!-- ── My Service Requests: detail ─────────────────────────────────────── -->
    <template id="portal_my_service_request" name="My Service Request">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 mb-5">
                <a href="/my/service-requests" class="btn btn-link px-0 mb-2">
                    <i class="fa fa-arrow-left me-1"/>My Service Requests
                </a>
                <div class="card shadow-sm border-0">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center"
                         style="background: linear-gradient(135deg,#1a1a2e,#16213e); color:#fff;">
                        <h5 class="mb-0">#
                            <t t-out="ticket.id"/>
                            —
                            <t t-out="ticket.name"/>
                        </h5>
                        <span class="badge text-bg-light" t-out="ticket.stage_id.name"/>
                    </div>
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <strong>Submitted:</strong>
                                    <span t-field="ticket.create_date"/>
                                </p>
                                <p class="mb-2">
                                    <strong>Approval:</strong>
                                    <t t-if="ticket.manager_approval_state == 'waiting_manager_approval'">Waiting for
                                        manager
                                    </t>
                                    <t t-elif="ticket.manager_approval_state == 'approved'">Approved</t>
                                    <t t-elif="ticket.manager_approval_state == 'denied'">Denied</t>
                                    <t t-else="">—</t>
                                </p>
                                <p class="mb-2" t-if="ticket.portal_approver_id or ticket.manager_employee_id">
                                    <strong>Approver:</strong>
                                    <t t-out="ticket.portal_approver_id.name or ticket.manager_employee_id.name"/>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-2" t-if="line.job_category_id">
                                    <strong>Job Category:</strong>
                                    <t t-out="line.job_category_id.name"/>
                                </p>
                                <p class="mb-2" t-if="line.location_id">
                                    <strong>Location:</strong>
                                    <t t-out="line.location_id.name"/>
                                    <t t-if="line.sublocation_id">/
                                        <t t-out="line.sublocation_id.name"/>
                                    </t>
                                </p>
                                <p class="mb-2" t-if="line.building">
                                    <strong>Building / Unit:</strong>
                                    <t t-out="line.building"/>
                                </p>
                                <p class="mb-2" t-if="ticket.asset_id">
                                    <strong>Asset:</strong>
                                    <t t-out="ticket.asset_id.name"/>
                                </p>
                            </div>
                        </div>
                        <hr/>
                        <h6 class="fw-bold">Description</h6>
                        <div t-field="ticket.description"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
