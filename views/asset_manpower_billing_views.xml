<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         CONFIGURATION
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_manpower_billing_config_form" model="ir.ui.view">
        <field name="name">manpower.billing.config.form</field>
        <field name="model">manpower.billing.config</field>
        <field name="arch" type="xml">
            <form string="Manpower Billing Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Rate &amp; Period Settings">
                        <group>
                            <field name="default_daily_rate"
                                   string="Default Daily Rate (per manday)"/>
                            <field name="working_days_per_month"
                                   string="Working Days per Month"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="default_labour_product_id"
                                   options="{'no_create': True}"
                                   string="Default Labour Product (for invoices)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_manpower_billing_config_list" model="ir.ui.view">
        <field name="name">manpower.billing.config.list</field>
        <field name="model">manpower.billing.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="default_daily_rate" string="Daily Rate"/>
                <field name="working_days_per_month" string="Working Days/Month"/>
                <field name="currency_id"/>
                <field name="default_labour_product_id" string="Labour Product"/>
            </list>
        </field>
    </record>

    <record id="action_manpower_billing_config" model="ir.actions.act_window">
        <field name="name">Manpower Settings</field>
        <field name="res_model">manpower.billing.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         IMPORT BATCH
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_manpower_import_batch_form" model="ir.ui.view">
        <field name="name">manpower.import.batch.form</field>
        <field name="model">manpower.import.batch</field>
        <field name="arch" type="xml">
            <form string="Manpower Import Batch">
                <header>
                    <button name="action_import_excel"
                            string="Import Excel"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_import_excel"
                            string="Re-Import Excel"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'confirmed'"
                            confirm="Re-importing will delete existing data for this batch. Continue?"/>
                    <button name="action_confirm"
                            string="Confirm Batch"
                            type="object"
                            class="btn-success"
                            invisible="state != 'imported'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,imported,confirmed"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_summaries"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-building">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_companies"/>
                                </span>
                                <span class="o_stat_text">Companies</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_view_summaries"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_mandays"/>
                                </span>
                                <span class="o_stat_text">Mandays</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_view_summaries"
                                class="oe_stat_button"
                                icon="fa-users">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_employees"/>
                                </span>
                                <span class="o_stat_text">Employees</span>
                            </div>
                        </button>
                        <button type="object"
                                name="action_view_summaries"
                                class="oe_stat_button"
                                icon="fa-money">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_billed_amount"
                                           widget="monetary"/>
                                </span>
                                <span class="o_stat_text">Billed Amount</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Batch name e.g. Feb 2026 Manpower"/>
                        </h1>
                    </div>

                    <group string="Period">
                        <group>
                            <field name="period_month"/>
                            <field name="period_year"/>
                            <field name="period_label" readonly="1"/>
                        </group>
                    </group>

                    <group string="Upload Excel File">
                        <div class="alert alert-info" role="alert">
                            <i class="fa fa-info-circle mr-1"/>
                            Upload an Excel file with columns: <b>Employee Code</b>, <b>Sh date</b>, <b>ATSECN</b>.
                            Click <b>Import Excel</b> to process. The system will automatically
                            calculate mandays, employee equivalents, and billing amounts per company.
                        </div>
                        <field name="import_file"
                               string="Excel File"
                               widget="binary"
                               filename="import_filename"
                               nolabel="1"/>
                        <field name="import_filename" invisible="1"/>
                    </group>

                    <notebook invisible="state == 'draft'">

                        <page string="Company Summaries" name="summaries">
                            <field name="summary_line_ids" readonly="1">
                                <list>
                                    <field name="atsecn" string="ATSECN Code"/>
                                    <field name="partner_id" string="Company"/>
                                    <field name="total_mandays" string="Mandays"/>
                                    <field name="unique_employees" string="Unique Emps"/>
                                    <field name="employee_equivalent"
                                           string="FTE Equiv."
                                           digits="[10,2]"/>
                                    <field name="daily_rate" string="Rate/Day"/>
                                    <field name="billed_amount" string="Billed Amount"/>
                                    <field name="invoice_count" string="Invoices"/>
                                    <button name="action_create_invoice"
                                            string="Invoice"
                                            type="object"
                                            icon="fa-file-invoice"
                                            class="btn-primary btn-sm"
                                            invisible="invoice_count &gt; 0"/>
                                    <button name="action_view_invoices"
                                            string="View"
                                            type="object"
                                            icon="fa-eye"
                                            class="btn-secondary btn-sm"
                                            invisible="invoice_count == 0"/>
                                </list>
                            </field>
                        </page>

                        <page string="Raw Attendance Lines" name="raw">
                            <field name="raw_line_ids" readonly="1">
                                <list>
                                    <field name="atsecn" string="ATSECN"/>
                                    <field name="partner_id" string="Company"/>
                                    <field name="employee_code" string="Emp Code"/>
                                    <field name="employee_id" string="Employee"/>
                                    <field name="shift_date" string="Shift Date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes about this import batch..."/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_import_batch_list" model="ir.ui.view">
        <field name="name">manpower.import.batch.list</field>
        <field name="model">manpower.import.batch</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'"
                  decoration-warning="state == 'imported'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="period_label" string="Period"/>
                <field name="total_companies" string="Companies"/>
                <field name="total_mandays" string="Mandays"/>
                <field name="total_employees" string="Employees"/>
                <field name="total_billed_amount" string="Billed Amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'imported'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_import_batch_search" model="ir.ui.view">
        <field name="name">manpower.import.batch.search</field>
        <field name="model">manpower.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <filter string="Draft" name="flt_draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Imported" name="flt_imported"
                        domain="[('state','=','imported')]"/>
                <filter string="Confirmed" name="flt_confirmed"
                        domain="[('state','=','confirmed')]"/>
                <separator/>
                <filter string="Group by Year" name="grp_year"
                        context="{'group_by':'period_year'}"/>
                <filter string="Group by Month" name="grp_month"
                        context="{'group_by':'period_month'}"/>
            </search>
        </field>
    </record>

    <record id="action_manpower_import_batch" model="ir.actions.act_window">
        <field name="name">Manpower Import Batches</field>
        <field name="res_model">manpower.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_manpower_import_batch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No batches yet</p>
            <p>Create a new batch, upload your attendance Excel file, and click Import Excel.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         BILLING SUMMARY
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_manpower_billing_summary_form" model="ir.ui.view">
        <field name="name">manpower.billing.summary.form</field>
        <field name="model">manpower.billing.summary</field>
        <field name="arch" type="xml">
            <form string="Manpower Billing Summary">
                <header>
                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-primary"
                            invisible="not partner_id"/>
                    <button name="action_view_invoices"
                            string="View Invoices"
                            type="object"
                            class="btn-secondary"
                            invisible="invoice_count == 0"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_raw_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_mandays"/>
                                </span>
                                <span class="o_stat_text">Mandays</span>
                            </div>
                        </button>
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-invoice"
                                invisible="invoice_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="invoice_count"/>
                                </span>
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="atsecn" string="ATSECN Code"/>
                        <h1>
                            <field name="atsecn" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Warning if no partner linked -->
                    <div class="alert alert-warning mb-3"
                         invisible="partner_id">
                        <i class="fa fa-exclamation-triangle mr-1"/>
                        No company linked to ATSECN code
                        <strong>
                            <field name="atsecn" readonly="1"/>
                        </strong>
                        .
                        Please set a partner to enable invoicing.
                        Tip: Set the <b>Company Registry</b> or <b>Reference</b> field on the partner to match this
                        code.
                    </div>

                    <group string="Company &amp; Period">
                        <group>
                            <field name="partner_id"
                                   options="{'no_create': True}"
                                   string="Company / Client"/>
                            <field name="atsecn" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="period_month" readonly="1"/>
                            <field name="period_year" readonly="1"/>
                            <field name="period_label" readonly="1"/>
                        </group>
                    </group>

                    <group string="Manpower Statistics">
                        <group>
                            <field name="total_mandays"
                                   string="Total Mandays"
                                   readonly="1"/>
                            <field name="unique_employees"
                                   string="Unique Employees"
                                   readonly="1"/>
                            <field name="employee_equivalent"
                                   string="Employee Equivalent (FTE)"
                                   readonly="1"
                                   help="Total Mandays ÷ Working Days per Month"/>
                        </group>
                        <group>
                            <field name="working_days_per_month"
                                   string="Working Days / Month"/>
                        </group>
                    </group>

                    <group string="Billing">
                        <group>
                            <field name="daily_rate" string="Daily Rate"/>
                            <field name="billed_amount"
                                   string="Billed Amount"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="total_invoiced"
                                   string="Total Invoiced"
                                   readonly="1"
                                   invisible="invoice_count == 0"/>
                            <field name="invoice_state"
                                   string="Payment Status"
                                   readonly="1"
                                   invisible="invoice_count == 0"
                                   widget="badge"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Notes for this company billing..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_billing_summary_list" model="ir.ui.view">
        <field name="name">manpower.billing.summary.list</field>
        <field name="model">manpower.billing.summary</field>
        <field name="arch" type="xml">
            <list decoration-warning="not partner_id"
                  decoration-success="invoice_count &gt; 0">
                <field name="period_label" string="Period"/>
                <field name="atsecn" string="ATSECN Code"/>
                <field name="partner_id" string="Company"/>
                <field name="total_mandays" string="Mandays"/>
                <field name="unique_employees" string="Employees"/>
                <field name="employee_equivalent" string="FTE Equiv." digits="[10,2]"/>
                <field name="daily_rate" string="Rate/Day"/>
                <field name="billed_amount" string="Billed Amount"/>
                <field name="total_invoiced" string="Invoiced" optional="show"/>
                <field name="invoice_count" string="Invoices"/>
                <field name="invoice_state" string="Payment" optional="show"/>
                <button name="action_create_invoice"
                        string="Invoice"
                        type="object"
                        icon="fa-file-invoice"
                        class="btn-primary btn-sm"
                        invisible="invoice_count &gt; 0"/>
                <button name="action_view_invoices"
                        string="Invoices"
                        type="object"
                        icon="fa-eye"
                        class="btn-secondary btn-sm"
                        invisible="invoice_count == 0"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_billing_summary_search" model="ir.ui.view">
        <field name="name">manpower.billing.summary.search</field>
        <field name="model">manpower.billing.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="atsecn"/>
                <field name="partner_id"/>
                <field name="batch_id"/>
                <filter string="No Partner Linked" name="flt_no_partner"
                        domain="[('partner_id','=',False)]"/>
                <filter string="Not Invoiced" name="flt_not_invoiced"
                        domain="[('invoice_ids','=',False)]"/>
                <filter string="Invoiced" name="flt_invoiced"
                        domain="[('invoice_ids','!=',False)]"/>
                <separator/>
                <filter string="Group by Company" name="grp_partner"
                        context="{'group_by':'partner_id'}"/>
                <filter string="Group by Period" name="grp_period"
                        context="{'group_by':'period_label'}"/>
                <filter string="Group by ATSECN" name="grp_atsecn"
                        context="{'group_by':'atsecn'}"/>
                <searchpanel>
                    <field name="partner_id" string="Company"
                           icon="fa-building" select="multi"/>
                    <field name="period_month" string="Month"
                           icon="fa-calendar" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_manpower_billing_summary" model="ir.actions.act_window">
        <field name="name">Billing Summaries</field>
        <field name="res_model">manpower.billing.summary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_manpower_billing_summary_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No billing summaries yet</p>
            <p>Import an attendance batch to generate company billing summaries.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         RAW LINES
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_manpower_import_line_list" model="ir.ui.view">
        <field name="name">manpower.import.line.list</field>
        <field name="model">manpower.import.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="batch_id" string="Batch" optional="show"/>
                <field name="atsecn" string="ATSECN"/>
                <field name="partner_id" string="Company"/>
                <field name="employee_code" string="Emp Code"/>
                <field name="employee_id" string="Employee"/>
                <field name="shift_date" string="Shift Date"/>
            </list>
        </field>
    </record>

    <record id="action_manpower_import_line" model="ir.actions.act_window">
        <field name="name">Raw Attendance Lines</field>
        <field name="res_model">manpower.import.line</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         INVOICE WIZARD
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_manpower_invoice_wizard_form" model="ir.ui.view">
        <field name="name">manpower.invoice.wizard.form</field>
        <field name="model">manpower.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Manpower Invoice">
                <sheet>
                    <div class="alert alert-info mb-3">
                        <i class="fa fa-info-circle mr-1"/>
                        Choose the billing period to consolidate multiple months into a single invoice.
                        The daily rate and labour product can be overridden below.
                    </div>

                    <group string="Invoice Details">
                        <group>
                            <field name="partner_id"
                                   options="{'no_create': True}"
                                   readonly="1"/>
                            <field name="invoice_date"/>
                            <field name="billing_period"/>
                        </group>
                        <group>
                            <field name="labour_product_id"
                                   options="{'no_create': True}"/>
                            <field name="daily_rate"
                                   string="Daily Rate Override"
                                   help="Leave 0 to use each period's configured rate."/>
                        </group>
                    </group>

                    <group string="Custom Period Selection"
                           invisible="billing_period != 'custom'">
                        <field name="custom_summary_ids"
                               nolabel="1"
                               domain="[('partner_id','=',partner_id)]">
                            <list>
                                <field name="period_label" string="Period"/>
                                <field name="atsecn"/>
                                <field name="total_mandays"/>
                                <field name="billed_amount"/>
                            </list>
                        </field>
                    </group>

                    <group string="Notes / Narration">
                        <field name="notes" nolabel="1"
                               placeholder="Optional note to appear on the invoice..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>