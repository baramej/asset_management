<odoo>
    <record id="view_asset_location_list" model="ir.ui.view">
        <field name="name">asset.location.list</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="gps_latitude"/>
                <field name="gps_longitude"/>
            </list>
        </field>
    </record>

    <record id="view_asset_location_form" model="ir.ui.view">
        <field name="name">asset.location.form</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <header>
                    <button name="open_google_maps"
                            type="object"
                            string="Open in Google Maps"
                            class="btn-primary"
                            invisible="not (gps_latitude and gps_longitude)"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="map_url"
                                   placeholder="Paste Google Maps link here"/>
                            <field name="gps_latitude"/>
                            <field name="gps_longitude"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Map">
                            <field name="map_iframe" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">asset.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
