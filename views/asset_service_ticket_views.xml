<odoo>
    <record id="view_asset_service_ticket_list" model="ir.ui.view">
        <field name="name">asset.service.ticket.list</field>
        <field name="model">asset.service.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="ticket_type"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="deadline"/>
                <field name="assigned_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_asset_service_ticket_form" model="ir.ui.view">
        <field name="name">asset.service.ticket.form</field>
        <field name="model">asset.service.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="asset_id"/>
                        <field name="ticket_type"/>
                        <field name="reason"/>
                        <field name="priority"/>
                    </group>
                    <group>
                        <field name="requester_id"/>
                        <field name="assigned_user_id"/>
                        <field name="tat_hours"/>
                        <field name="deadline"/>
                        <field name="escalation_level" readonly="1"/>
                    </group>
                    <group>
                        <field name="is_under_warranty" readonly="1"/>
                        <field name="state"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Chatter">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_form_inherit_asset" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.asset</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_view_maintenance_task"
                        type="object"
                        string="View Maintenance Task"
                        class="btn-secondary"
                        invisible="maintenance_task_id == False"
                        groups="asset_management.group_asset_inspector,asset_management.group_asset_manager"
                />
            </xpath>

        </field>
    </record>

    <record id="action_asset_service_ticket" model="ir.actions.act_window">
        <field name="name">Service Tickets</field>
        <field name="res_model">asset.service.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
